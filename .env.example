# ============================================================
# LogicKids Backend — Variables de entorno
# Copia este archivo como .env y rellena los valores
# NUNCA subas .env a git (ya está en .gitignore)
# ============================================================

NODE_ENV=development
PORT=3001

# --- Base de datos PostgreSQL ---

# OPCIÓN 1: Railway (Nube compartida del equipo - POR DEFECTO)
# Pide la contraseña al líder del equipo para conectarte.
DB_HOST=metro.proxy.rlwy.net
DB_PORT=32786
DB_NAME=railway
DB_USER=postgres
DB_PASSWORD=INGRESA_AQUI_LA_PASSWORD_DE_RAILWAY

# OPCIÓN 2: Desarrollo Local (Como se hacía antes)
# Usa esta opción solo si prefieres tener PostgreSQL instalado en tu computadora local.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=logickids
# DB_USER=postgres
# DB_PASSWORD=tu_password_local

# --- JWT ---
# Mínimo 32 caracteres. Genera uno seguro con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_de_al_menos_32_caracteres
JWT_STUDENT_SECRET=otro_secreto_diferente_para_estudiantes_32chars
JWT_EXPIRES_IN=7d
JWT_STUDENT_EXPIRES_IN=4h
JWT_STUDENT_ISSUER=logickids-backend
JWT_STUDENT_AUDIENCE=logickids-student-mobile

# --- Sesiones infantiles ---
# Duraciones en minutos y limites por ventana. Ajustar por ambiente sin tocar codigo.
STUDENT_DEVICE_SESSION_TTL_MINUTES=240
STUDENT_DEVICE_INACTIVITY_MINUTES=30
STUDENT_LOGIN_WINDOW_MINUTES=15
STUDENT_LOGIN_BLOCK_MINUTES=15
STUDENT_LOGIN_MAX_ATTEMPTS=5
STUDENT_LOGIN_MAX_ATTEMPTS_PER_IP=300

# --- CORS ---
# En producción, pon las URLs exactas del frontend.
# Tambien puedes usar comodines controlados para previews del mismo proyecto,
# por ejemplo: https://logickids-frontend-sena*.vercel.app
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://logickids-frontend-sena.vercel.app,https://logickids-frontend-sena-git-develop-camilo-s-projects19.vercel.app

# --- Correo ---
# URL publica HTTPS del backend para cargar imagenes del correo sin adjuntos.
# Ejemplo en produccion: https://logickids-backend-sena-production.up.railway.app
# En local no uses localhost para correos reales: Gmail no puede cargarlo.
EMAIL_PUBLIC_BASE_URL=https://logickids-backend-sena-production.up.railway.app

# --- IA (Gemini) ---
# Opcional: si no se define, el sistema usa respuestas simuladas
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

