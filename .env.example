# ============================================================
# LogicKids Backend — Variables de entorno
# Copia este archivo como .env y rellena los valores
# NUNCA subas .env a git (ya está en .gitignore)
# ============================================================

NODE_ENV=development
PORT=3001

# --- Base de datos PostgreSQL ---
# Para conectarte a Railway (DB del equipo en la nube):
#   DB_HOST=metro.proxy.rlwy.net  |  DB_PORT=32786  |  DB_NAME=railway
# Para local: DB_HOST=localhost  |  DB_PORT=5432  |  DB_NAME=logickids
# La password de Railway pídela al líder del equipo (no se sube al repo)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=logickids
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# --- JWT ---
# Mínimo 32 caracteres. Genera uno seguro con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_de_al_menos_32_caracteres
JWT_STUDENT_SECRET=otro_secreto_diferente_para_estudiantes_32chars
JWT_EXPIRES_IN=7d
JWT_STUDENT_EXPIRES_IN=4h

# --- CORS ---
# En producción, pon la URL exacta del frontend
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# --- IA (Gemini) ---
# Opcional: si no se define, el sistema usa respuestas simuladas
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
