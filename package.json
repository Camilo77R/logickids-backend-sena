{
  "name": "logickids-backend",
  "version": "2.0.0",
  "description": "LogicKids Backend v2 — Express + Knex + PostgreSQL",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "provision:codigo-estelar": "node scripts/provision-codigo-estelar-demo.mjs",
    "provision:codigo-estelar:6": "node scripts/provision-codigo-estelar-demo.mjs --students=6",
    "dataset:export:recomendaciones": "node scripts/export-recommendation-dataset.mjs",
    "test": "vitest run",
    "test:backend:full": "vitest run",
    "test:capa1": "vitest run tests/auth.test.js tests/tenant-security.test.js",
    "test:capa2": "vitest run tests/lifecycle-rules.test.js tests/solicitudes-reactivacion.test.js tests/institution-centric-model.test.js",
    "test:capa3": "vitest run tests/student-dashboard.test.js tests/student-access-operations.test.js tests/sesiones-codigo-estelar.test.js",
    "test:capa4": "vitest run tests/matriz-estados-sesiones.test.js tests/realtime-ranking.test.js tests/codigo-estelar-sockets.test.js",
    "test:capa5": "vitest run tests/analytics-achievements-recommendations.test.js",
    "test:capa6": "vitest run tests/ia-csv-integration.test.js",
    "test:capas:cerradas": "vitest run tests/auth.test.js tests/tenant-security.test.js tests/lifecycle-rules.test.js tests/solicitudes-reactivacion.test.js tests/institution-centric-model.test.js tests/student-dashboard.test.js tests/student-access-operations.test.js tests/sesiones-codigo-estelar.test.js tests/matriz-estados-sesiones.test.js tests/realtime-ranking.test.js tests/codigo-estelar-sockets.test.js tests/analytics-achievements-recommendations.test.js tests/ia-csv-integration.test.js",
    "test:cleanup:institutions": "node scripts/cleanup-test-institutions.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "form-data": "^4.0.5",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "nodemailer": "^8.0.7",
    "pg": "^8.12.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.5"
  }
}
